{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "agent-kernel-extension/src/**/*.ts",
    "external-plugins/src/**/*.ts",
    "scripts/one-shot.ts"
  ],
  "exclude": [
    "agent-kernel"
  ]
}
