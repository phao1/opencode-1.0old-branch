    21	          } else {
    22	            await previous(...args)
    23	            await value(...args)
    24	          }
    25	        }
    26	      } else throw new Error(`Duplicate non-composable plugin hook: ${key}`)
    27	    }
    28	  }
    29	  return { ...merged, tool: tools } as Hooks
    30	}
