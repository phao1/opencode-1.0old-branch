    47	  export interface Interface {
    48	    readonly get: (sessionID: SessionID) => Effect.Effect<Info>
    49	    readonly list: () => Effect.Effect<Map<SessionID, Info>>
    50	    readonly set: (sessionID: SessionID, status: Info) => Effect.Effect<void>
