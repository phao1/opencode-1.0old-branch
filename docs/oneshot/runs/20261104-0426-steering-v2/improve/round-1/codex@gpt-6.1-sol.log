    11	export async function startKernel({ plugin, config = {}, directory = root, reuseFixture } = {}) {
    12	  await mkdir(path.join(root, '.codeagent'), { recursive: true })
    13	  const fixture = reuseFixture ? path.resolve(reuseFixture) : await mkdtemp(path.join(root, '.codeagent/kernel-lab-'))
    14	  const configDir = path.join(fixture, 'config/opencode')
    15	  if (reuseFixture) {
    16	    // Restart means reuse the exact installed config, database and state.
    17	    // Reject a missing fixture rather than silently create a fresh instance.
    18	    await readFile(path.join(configDir, 'opencode.json'), 'utf8')
    19	  } else {
    20	  await mkdir(configDir, { recursive: true })
    21	  await writeFile(path.join(configDir, 'package.json'), JSON.stringify({ private: true, dependencies: { '@opencode-ai/plugin': '1.3.17' } }))
    22	  // An actual installation produces the lockfile; no fabricated dependency
    23	  // metadata or patches to Config.waitForDependencies are used.
    24	  await run('npm', ['install', '--prefix', configDir, '--ignore-scripts', '--no-audit', '--no-fund', '--prefer-offline', '--fetch-timeout=15000', '--fetch-retries=0', '--registry=https://registry.npmjs.org'], { timeout: 60_000 })
    25	  await writeFile(path.join(configDir, 'opencode.json'), JSON.stringify({
    26	    plugin: [plugin ?? path.join(root, 'external-plugins/src/index.ts')], ...config,
