    30	  const env = { ...process.env }
    31	  for (const key of Object.keys(env)) if (key.startsWith('OPENCODE_')) delete env[key]
    32	  Object.assign(env, {
    33	    XDG_CONFIG_HOME: path.join(fixture, 'config'), XDG_DATA_HOME: path.join(fixture, 'data'),
    34	    XDG_CACHE_HOME: path.join(fixture, 'cache'), XDG_STATE_HOME: path.join(fixture, 'state'),
    35	    OPENCODE_TEST_HOME: path.join(fixture, 'home'), OPENCODE_CONFIG_DIR: configDir,
    36	    OPENCODE_DISABLE_PROJECT_CONFIG: 'true', OPENCODE_DISABLE_MODELS_FETCH: 'true',
    37	  })
    38	  const server = spawn(process.env.BUN_BINARY ?? 'bun', ['src/index.ts', 'serve', '--port', '0', '--hostname', '127.0.0.1', '--print-logs'], {
    39	    cwd: path.join(process.env.KERNEL_ROOT ?? path.join(root, 'agent-kernel'), 'packages/opencode'),
    40	    env, stdio: ['ignore', 'pipe', 'pipe'],
    41	  })
    42	  let logs = ''
    43	  const exited = new Promise(resolve => server.once('exit', resolve))
    44	  const stop = async () => {
    45	    if (server.exitCode === null && server.signalCode === null) {
    46	      server.kill('SIGTERM')
    47	      const timer = setTimeout(() => server.kill('SIGKILL'), 1500)
    48	      await exited
    49	      clearTimeout(timer)
    50	    }
    51	    await writeFile(path.join(fixture, 'kernel.log'), logs)
    52	    await writeFile(logFile, logs)
    53	  }
    54	  try {
    55	    const url = await new Promise((resolve, reject) => {
    56	      const timer = setTimeout(() => reject(new Error('Kernel startup timeout')), 60_000)
    57	      const output = data => {
    58	        logs += data.toString()
    59	        const match = logs.match(/listening on (http:\/\/127\.0\.0\.1:\d+)/)
    60	        if (match) { clearTimeout(timer); resolve(match[1]) }
    61	      }
    62	      server.stdout.on('data', output); server.stderr.on('data', output)
    63	      server.once('error', err => { clearTimeout(timer); reject(err) })
    64	      server.once('exit', code => { clearTimeout(timer); reject(new Error(`Kernel exited ${code}`)) })
