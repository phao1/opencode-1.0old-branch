    67	      url, fixture, stop, logFile, pid: server.pid,
    68	      async request(route, body, method = body === undefined ? 'GET' : 'POST') {
    69	        const response = await fetch(`${url}${route}${route.includes('?') ? '&' : '?'}directory=${encodeURIComponent(directory)}`, {
    70	          method, headers: { 'content-type': 'application/json' },
    71	          body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(45_000),
    72	        })
    73	        const text = await response.text()
    74	        if (!response.ok) throw new Error(`${method} ${route}: ${response.status} ${text.slice(0, 2000)}`)
    75	        return text ? JSON.parse(text) : undefined
    76	      },
    77	    }
    78	  } catch (error) {
    79	    await stop()
    80	    throw new Error(`${error.message}\n${logs.slice(-5000)}\nFixture: ${fixture}`, { cause: error })
    81	  }
    82	}
    83	
    84	export async function run(command, args, { timeout = 60_000, cwd = root, input } = {}) {
    85	  return new Promise((resolve, reject) => {
    86	    const proc = spawn(command, args, { cwd, stdio: ['pipe', 'pipe', 'pipe'] })
    87	    let stdout = '', stderr = ''
    88	    const timer = setTimeout(() => proc.kill('SIGKILL'), timeout)
    89	    proc.stdout.on('data', data => { stdout += data })
    90	    proc.stderr.on('data', data => { stderr += data })
    91	    proc.once('error', error => { clearTimeout(timer); reject(error) })
    92	    proc.once('exit', (code, signal) => {
    93	      clearTimeout(timer)
    94	      if (code === 0) resolve(stdout)
    95	      else reject(new Error(`${command} exited ${code ?? signal}: ${stderr.slice(-3000)}`))
    96	    })
    97	    proc.stdin.end(input)
    98	  })
    99	}

