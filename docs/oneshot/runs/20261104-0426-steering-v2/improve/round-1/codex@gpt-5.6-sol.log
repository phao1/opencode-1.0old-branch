     3	export function composeSteeringHooks(...hooks: Hooks[]): Hooks {
     4	  const merged: Record<string, unknown> = {}
     5	  const tools: NonNullable<Hooks["tool"]> = {}
     6	  for (const hook of hooks) {
     7	    for (const [name, definition] of Object.entries(hook.tool ?? {})) {
     8	      if (name in tools) throw new Error(`Duplicate plugin tool: ${name}`)
     9	      tools[name] = definition
    10	    }
    11	    for (const [key, value] of Object.entries(hook)) {
    12	      if (key === "tool" || value === undefined) continue
    13	      const previous = merged[key]
    14	      if (previous === undefined) merged[key] = value
    15	      else if (typeof previous === "function" && typeof value === "function") {
    16	        merged[key] = async (...args: unknown[]) => {
    17	          if (key === "event") {
    18	            const results = await Promise.allSettled([previous(...args), value(...args)])
    19	            const failed = results.find(result => result.status === "rejected")
    20	            if (failed?.status === "rejected") throw failed.reason
    21	          } else {
    22	            await previous(...args)
    23	            await value(...args)
    24	          }
    25	        }
    26	      } else throw new Error(`Duplicate non-composable plugin hook: ${key}`)
    27	    }
    28	  }
    29	  return { ...merged, tool: tools } as Hooks
    30	}
