   254	  private async resume(sessionID: string, epoch: number) {
   255	    // Persist attempt inside the queue, then dispatch OUTSIDE it: promptAsync
   256	    // re-enters chat.message and would deadlock if the queue were held.
   257	    const request = await this.serial(sessionID, async state => {
   258	      if (epoch !== this.epoch(sessionID) || state.lifecycle !== "idle" || this.deleted.has(sessionID)) return
