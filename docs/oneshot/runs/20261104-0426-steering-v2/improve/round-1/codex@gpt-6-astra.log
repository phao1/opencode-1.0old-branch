   260	      const assistant = this.latestAssistant(messages)
   261	      const pending = this.pending(state)
   262	      if (!pending.length || !this.successful(assistant) || state.evidence !== "available" || !await this.idle(sessionID) || epoch !== this.epoch(sessionID)) return
