     4	
     5	// The legacy loader calls every exported function. Keep only the plugin here.
     6	export const SteeringPlugin: Plugin = async (input, options = {}) => {
     7	  const ledger = new SteeringLedger(input, options)
     8	  return {
     9	    tool: {
    10	      steering_status: {
    11	        description: "Read message-level steering evidence for this session. Saved and prepared do not prove provider receipt or semantic adoption.",
    12	        args: { messageID: z.string().optional() },
    13	        async execute(args, context) {
    14	          return JSON.stringify(await ledger.status(context.sessionID, typeof args.messageID === "string" ? args.messageID : undefined), null, 2)
    15	        },
    16	      },
    17	    },
    18	    "chat.message": (input, output) => ledger.observe(input.sessionID, output),
    19	    "experimental.chat.messages.transform": (_, output) => ledger.prepare(output),
    20	    "experimental.session.compacting": input => ledger.compacting(input.sessionID),
    21	    "tool.execute.before": input => ledger.gate(input),
    22	    // Event hooks are not awaited by the kernel; the ledger catches rejections.
    23	    event: ({ event }) => ledger.event(event),
    24	  }
    25	}

