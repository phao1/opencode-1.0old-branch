   121	  const target = path.join(f.directory, 'normal.txt')
   122	  finish(f.held[0], null, [{ name: 'bash', args: { command: `printf normal > '${target}'`, description: 'normal' } }])
   123	  await until(() => f.requests.length === 2); finish(f.held[1]); await until(f.idle); await delay(200)
   124	  assert.equal(await readFile(target, 'utf8'), 'normal'); assert.equal(f.requests.length, 2)
