    84	  await f.submit('TASK: finish original task.')
    85	  await until(() => f.waits.has('task'), 'task ID allocated')
    86	  await f.submit('GUIDE: corrected late-save guidance', { system: 'inherited-system', variant: 'chosen', format: { type: 'text' },
    87	    parts: [{ type: 'text', text: 'GUIDE: corrected late-save guidance' }, { type: 'file', mime: 'text/plain', filename: 'guide.txt', url: 'data:text/plain;base64,YXR0YWNobWVudA==' }] })
    88	  await until(() => f.waits.has('guide'), 'guide ID allocated')
    89	  f.waits.get('task').end('{}'); await until(() => f.requests.length === 1, 'initial request')
    90	  assert.ok(!JSON.stringify(f.requests[0]).includes('GUIDE:'))
    91	  f.waits.get('guide').end('{}')
    92	  let originals, guide
    93	  await until(async () => { originals = await f.messages(); guide = originals.find(m => m.parts.some(p => p.text?.startsWith('GUIDE:'))); return guide?.parts.some(p => p.type === 'file') && guide.parts.some(p => p.text === 'attachment') }, 'all guide parts saved')
    94	  const a = originals.find(m => m.info.role === 'assistant')
    95	  assert.ok(guide.info.id < a.info.id, 'Natural native IDs establish actual late save')
    96	  const permissions = (await f.request(f.route)).permission
    97	  finish(f.held[0])
    98	  if (enabled) {
    99	    await until(() => f.requests.length === 2, 'automatic continuation')
   100	    assert.ok(JSON.stringify(f.requests[1]).includes('GUIDE:'))
   101	    assert.ok(JSON.stringify(f.requests[1]).includes('Latest user guidance takes priority'))
   102	    finish(f.held[1]); await until(f.idle, 'continued idle')
   103	  } else await until(f.idle, 'native stopped without continuation')
   104	  await delay(300)
   105	  assert.equal(f.requests.length, enabled ? 2 : 1)
   106	  const saved = await f.messages(), users = saved.filter(m => m.info.role === 'user')
   107	  assert.equal(users.length, enabled ? 3 : 2)
   108	  assert.deepEqual(users.find(m => m.info.id === guide.info.id).parts, guide.parts)
   109	  assert.deepEqual((await f.request(f.route)).permission, permissions)
   110	  if (enabled) {
   111	    const control = users.find(m => !originals.some(o => o.info.id === m.info.id))
   112	    assert.ok(control.parts.some(p => p.synthetic && p.metadata?.codeagentSteering))
   113	    assert.equal(control.info.system, guide.info.system); assert.equal(control.info.variant, guide.info.variant); assert.deepEqual(control.info.format, guide.info.format)
   114	    assert.ok(!JSON.stringify(control.parts).includes('corrected late-save guidance'))
   115	  }
   116	})
