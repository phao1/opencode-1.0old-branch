     9	async function lab(t, enabled, { barriers = false, dispatchBarrier = false, extra = {} } = {}) {
    10	  const requests = [], held = [], events = [], waits = new Map()
    11	  await mkdir(path.join(root, '.codeagent'), { recursive: true })
    12	  const directory = await mkdtemp(path.join(root, '.codeagent/steering-v2-case-'))
    13	  const server = http.createServer(async (req, res) => {
    14	    let raw = ''; for await (const c of req) raw += c
    15	    if (req.url.startsWith('/barrier/')) { waits.set(req.url.split('/').at(-1), res); return }
    16	    if (req.url === '/event') { events.push(JSON.parse(raw)); res.end('{}'); return }
    17	    requests.push(JSON.parse(raw)); held.push(res)
    18	  })
    19	  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve))
    20	  const provider = `http://127.0.0.1:${server.address().port}`
    21	  const companion = path.join(directory, 'companion.mjs')
    22	  await writeFile(companion, `export default async ctx => {
    23	    if (${dispatchBarrier}) {
    24	      const get = ctx.client.session.get.bind(ctx.client.session); let once = false
    25	      ctx.client.session.get = async args => { if (!once) { once = true; await fetch(${JSON.stringify(provider + "/barrier/dispatch")}) }; return get(args) }
    26	    }
    27	    return ({
    28	    async 'chat.message'(_, out) {
    29	      const text = out.parts.find(p=>p.type==='text'&&!p.synthetic)?.text || ''
    30	      const which = ${barriers} && (text.startsWith('TASK:')?'task':text.startsWith('GUIDE:')?'guide':undefined)
    31	      await fetch(${JSON.stringify(provider + '/event')}, {method:'POST', body:JSON.stringify({kind:'message',which,id:out.message.id,parts:out.parts,info:out.message})})
    32	      if(which) await fetch(${JSON.stringify(provider + '/barrier/')}+which)
    33	    }
    34	  })}`)
    35	  let kernel
    36	  try { kernel = await startKernel({ provider, directory, plugin: [companion, ...(enabled ? [entry] : [])], extra }) }
    37	  catch (e) { server.closeAllConnections(); server.close(); throw e }
    38	  t.after(async () => {
    39	    for (const r of [...held, ...waits.values()]) r.destroy()
    40	    server.closeAllConnections(); await new Promise(resolve => server.close(resolve)); await kernel.stop()
    41	    await writeFile(path.join(directory, 'evidence.json'), JSON.stringify({ source: 'deterministic', enabled, requests, events }, null, 2))
    42	  })
    43	  const session = await kernel.request('/session', { title: 'Steering v2 integration', permission: [{ permission: '*', pattern: '*', action: 'allow' }] })
    44	  const route = '/session/' + session.id
    45	  const submit = (text, fields = {}) => kernel.request(route + '/prompt_async', { model, agent: 'build', parts: [{ type: 'text', text }], ...fields })
    46	  const messages = () => kernel.request(route + '/message')
    47	  const idle = async () => !(await kernel.request('/session/status'))[session.id]
    48	  return { ...kernel, directory, session, route, submit, messages, idle, requests, held, events, waits }
    49	}
